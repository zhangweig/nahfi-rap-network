# ---- 投稿审核（可选，不配置则沿用站内表单 + 本地 SQLite）----
# 飞书开放平台 → 自建应用（docs/feishu-setup.md 第一步）
# 把本文件复制成 .env 再填值。本文件会提交进仓库，切勿写入真实凭证。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格。打开表后在地址栏里找 /base/ 后面那段
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxxxx

# npm run feishu:init 会打印这一行，复制过来
FEISHU_TABLE_SUBMISSIONS=tblxxxxxxxxxxxxxx

# 表单分享链接。填了之后网站投稿按钮会跳到飞书表单
VITE_FEISHU_FORM_URL=

# ---- 本地服务（原有配置，未改动）----
# Local development: optional. A local owner key is created automatically if omitted.
# Production: supply a unique random secret of at least 16 characters.
ADMIN_PASSWORD=
# Set these only when deploying behind an HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=/absolute/path/to/persistent-data
