{
  "name": "nahfi-rap-network",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-data.mjs dist",
    "preview": "vite preview --host 0.0.0.0",
    "check:data": "node scripts/check-network.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server/index.mjs",
    "api:dev": "node scripts/build-data.mjs server/generated && wrangler dev",
    "api:schema": "wrangler d1 execute nahfi-rap-network --local --file=worker/schema.sql",
    "api:schema:remote": "wrangler d1 execute nahfi-rap-network --remote --file=worker/schema.sql",
    "api:deploy": "node scripts/build-data.mjs server/generated && wrangler deploy",
    "test:server": "node --test server/app.test.mjs",
    "data": "node scripts/build-data.mjs",
    "feishu:init": "node scripts/feishu-init.mjs",
    "feishu:check": "node scripts/feishu-check.mjs",
    "feishu:pull": "node scripts/feishu-pull.mjs",
    "backup": "node scripts/backup.mjs",
    "test:feishu": "node --test server/feishu.test.mjs",
    "sheet:export": "node scripts/sheet-export.mjs",
    "sheet:import": "node scripts/sheet-import.mjs"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.0.1",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.49.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.162.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
